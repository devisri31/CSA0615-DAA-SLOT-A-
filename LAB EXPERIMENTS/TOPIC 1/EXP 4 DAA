# Experiment 4: Fibonacci Series

def fibonacci_iterative(n):
    a, b = 0, 1
    print("Iterative Fibonacci Series:")
    for i in range(n):
        print(a, end=" ")
        a, b = b, a + b

memo = {}

def fibonacci_recursive(n):
    if n in memo:
        return memo[n]
    if n <= 1:
        return n
    memo[n] = fibonacci_recursive(n - 1) + fibonacci_recursive(n - 2)
    return memo[n]

n = int(input("Enter number of terms: "))

fibonacci_iterative(n)

print("\nRecursive Fibonacci Series:")
for i in range(n):
    print(fibonacci_recursive(i), end=" ")
