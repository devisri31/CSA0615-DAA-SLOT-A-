def merge_sort(a):
    global mc

    if len(a) > 1:
        m = len(a)//2
        l = a[:m]
        r = a[m:]

        merge_sort(l)
        merge_sort(r)

        i = j = k = 0

        while i < len(l) and j < len(r):
            mc += 1
            if l[i] <= r[j]:
                a[k] = l[i]
                i += 1
            else:
                a[k] = r[j]
                j += 1
            k += 1

        while i < len(l):
            a[k] = l[i]
            i += 1
            k += 1

        while j < len(r):
            a[k] = r[j]
            j += 1
            k += 1

def quick_sort(a, low, high):
    global qc

    if low < high:
        pivot = a[high]
        i = low-1

        for j in range(low, high):
            qc += 1
            if a[j] <= pivot:
                i += 1
                a[i], a[j] = a[j], a[i]

        a[i+1], a[high] = a[high], a[i+1]
        p = i+1

        quick_sort(a, low, p-1)
        quick_sort(a, p+1, high)

a = [5,4,3,2,1]

b = a.copy()
mc = 0
merge_sort(b)

c = a.copy()
qc = 0
quick_sort(c, 0, len(c)-1)

print("N =", len(a))
print("Merge Comparisons :", mc)
print("Quick Comparisons :", qc)

