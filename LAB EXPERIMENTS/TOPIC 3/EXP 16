text = "COMPUTERSCIENCE"
pattern = "SCI"

comparisons = 0

for i in range(len(text)-len(pattern)+1):
    match = True
    for j in range(len(pattern)):
        comparisons += 1
        if text[i+j] != pattern[j]:
            match = False
            break
    if match:
        print("First occurrence position =", i)
        print("Comparisons =", comparisons)
        break
