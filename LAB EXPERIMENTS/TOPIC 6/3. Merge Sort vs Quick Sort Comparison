a = [12,11,13,5,6,7]

def merge_sort(a):
    global mc
    if len(a) > 1:
        m = len(a)//2
        l = a[:m]
        r = a[m:]
        merge_sort(l)
        merge_sort(r)

        i = j = k = 0
        while i < len(l) and j < len(r):
            mc += 1
            if l[i] <= r[j]:
                a[k] = l[i]
                i += 1
            else:
                a[k] = r[j]
                j += 1
            k += 1

        while i < len(l):
            a[k] = l[i]
            i += 1
            k += 1

        while j < len(r):
            a[k] = r[j]
            j += 1
            k += 1

def partition(a, low, high):
    global qc
    pivot = a[high]
    i = low - 1
    for j in range(low, high):
        qc += 1
        if a[j] <= pivot:
            i += 1
            a[i], a[j] = a[j], a[i]
    a[i+1], a[high] = a[high], a[i+1]
    return i+1

def quick_sort(a, low, high):
    if low < high:
        p = partition(a, low, high)
        quick_sort(a, low, p-1)
        quick_sort(a, p+1, high)

b = a.copy()
c = a.copy()

mc = 0
merge_sort(b)

qc = 0
quick_sort(c, 0, len(c)-1)

print("Sorted Array :", *b, sep=" ")
print("Merge Comparisons :", mc)
print("Quick Comparisons :", qc)
