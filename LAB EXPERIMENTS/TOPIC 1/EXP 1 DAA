# Experiment 1: Linear Search (Iterative)

n = int(input("Enter number of elements: "))

arr = []
print("Enter elements:")
for i in range(n):
    arr.append(int(input()))

key = int(input("Enter key to search: "))

found = False

for i in range(n):
    if arr[i] == key:
        print("Key found at index", i)
        found = True
        break

if not found:
    print("Key not found")
