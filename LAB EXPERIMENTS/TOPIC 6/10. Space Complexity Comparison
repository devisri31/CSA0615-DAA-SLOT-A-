import sys

a = [5,3,8,4,2]

def merge_sort(a):
    if len(a) <= 1:
        return a

    m = len(a)//2
    l = merge_sort(a[:m])
    r = merge_sort(a[m:])

    result = []
    i = j = 0

    while i < len(l) and j < len(r):
        if l[i] <= r[j]:
            result.append(l[i])
            i += 1
        else:
            result.append(r[j])
            j += 1

    result += l[i:]
    result += r[j:]
    return result

def quick_sort(a, low, high):
    if low < high:
        pivot = a[high]
        i = low-1

        for j in range(low, high):
            if a[j] <= pivot:
                i += 1
                a[i], a[j] = a[j], a[i]

        a[i+1], a[high] = a[high], a[i+1]
        p = i+1

        quick_sort(a, low, p-1)
        quick_sort(a, p+1, high)

b = merge_sort(a.copy())
c = a.copy()
quick_sort(c, 0, len(c)-1)

print("Sorted :", *b, sep=" ")
print("Merge Space :", sys.getsizeof(b), "bytes")
print("Quick Space :", sys.getsizeof(c), "bytes")
