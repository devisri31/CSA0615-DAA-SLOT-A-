a = [1, 2, 2, 2, 3, 4, 5, 6]
key = 2

low = 0
high = len(a) - 1
first = -1

while low <= high:
    mid = (low + high) // 2

    if a[mid] == key:
        first = mid
        high = mid - 1
    elif a[mid] < key:
        low = mid + 1
    else:
        high = mid - 1

if first != -1:
    print("First occurrence at index", first)
else:
    print("Element not found")
