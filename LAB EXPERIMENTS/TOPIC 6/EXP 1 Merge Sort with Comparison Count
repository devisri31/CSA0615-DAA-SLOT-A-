a = [12,4,78,23,45,67,89,1]
count = 0

def merge_sort(a):
    global count
    if len(a) > 1:
        m = len(a)//2
        l = a[:m]
        r = a[m:]
        merge_sort(l)
        merge_sort(r)

        i = j = k = 0
        while i < len(l) and j < len(r):
            count += 1
            if l[i] <= r[j]:
                a[k] = l[i]
                i += 1
            else:
                a[k] = r[j]
                j += 1
            k += 1

        while i < len(l):
            a[k] = l[i]
            i += 1
            k += 1

        while j < len(r):
            a[k] = r[j]
            j += 1
            k += 1

merge_sort(a)
print(*a, sep=",")
print("Comparisons :", count)
