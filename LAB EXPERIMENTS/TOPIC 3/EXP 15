text = "AAAAAAAAAB"
pattern = "AAAAB"

comparisons = 0
found = False

for i in range(len(text)-len(pattern)+1):
    match = True
    for j in range(len(pattern)):
        comparisons += 1
        if text[i+j] != pattern[j]:
            match = False
            break
    if match:
        found = True
        break

print("Pattern Found:", found)
print("Comparisons =", comparisons)

print("\nComplexity")
print("Best Case : O(m)")
print("Average Case : O(nm)")
print("Worst Case : O(nm)")
