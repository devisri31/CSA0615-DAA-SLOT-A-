a = [2,4,1,3,5]
count = 0

def merge_sort(a):
    global count

    if len(a) <= 1:
        return a

    m = len(a)//2
    l = merge_sort(a[:m])
    r = merge_sort(a[m:])

    result = []
    i = j = 0

    while i < len(l) and j < len(r):
        if l[i] <= r[j]:
            result.append(l[i])
            i += 1
        else:
            result.append(r[j])
            count += len(l)-i
            j += 1

    result += l[i:]
    result += r[j:]
    return result

a = merge_sort(a)

print("Sorted :", *a, sep=" ")
print("Inversions :", count)
