text = "PROGRAMMINGLAB"
patterns = ["LAB", "TEST"]

for pattern in patterns:
    comparisons = 0
    found = False

    for i in range(len(text)-len(pattern)+1):
        match = True
        for j in range(len(pattern)):
            comparisons += 1
            if text[i+j] != pattern[j]:
                match = False
                break
        if match:
            found = True
            break

    print("\nPattern:", pattern)
    print("Found:", found)
    print("Comparisons:", comparisons)
