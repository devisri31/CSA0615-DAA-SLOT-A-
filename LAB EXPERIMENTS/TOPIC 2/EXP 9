n = int(input("Enter number of alerts: "))
a = list(map(int, input("Enter severity levels: ").split()))

for i in range(n):
    swapped = False
    for j in range(n - i - 1):
        if a[j] > a[j + 1]:
            a[j], a[j + 1] = a[j + 1], a[j]
            swapped = True
    if not swapped:
        break

print("Sorted Alerts:", a)
