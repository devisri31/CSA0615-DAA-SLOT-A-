priority = {"ambulance": 1, "bus": 2, "car": 3}

n = int(input("Enter number of vehicles: "))
a = input("Enter vehicles: ").split()

for i in range(n):
    for j in range(n - i - 1):
        if priority[a[j]] > priority[a[j + 1]]:
            a[j], a[j + 1] = a[j + 1], a[j]

print("Priority Queue:", a)
