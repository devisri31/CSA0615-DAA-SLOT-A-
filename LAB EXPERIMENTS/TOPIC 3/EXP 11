text = "AABAACAADAABAABA"
pattern = "AABA"

comparisons = 0
positions = []

for i in range(len(text) - len(pattern) + 1):
    match = True
    for j in range(len(pattern)):
        comparisons += 1
        if text[i + j] != pattern[j]:
            match = False
            break
    if match:
        positions.append(i)

print("Pattern found at positions:", positions)
print("Total comparisons =", comparisons)
