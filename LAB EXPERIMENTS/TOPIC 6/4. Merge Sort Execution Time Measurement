import time

a = [9,8,7,6,5,4,3]

def merge_sort(a):
    if len(a) > 1:
        m = len(a)//2
        l = a[:m]
        r = a[m:]
        merge_sort(l)
        merge_sort(r)

        i = j = k = 0
        while i < len(l) and j < len(r):
            if l[i] <= r[j]:
                a[k] = l[i]
                i += 1
            else:
                a[k] = r[j]
                j += 1
            k += 1

        while i < len(l):
            a[k] = l[i]
            i += 1
            k += 1

        while j < len(r):
            a[k] = r[j]
            j += 1
            k += 1

start = time.perf_counter()
merge_sort(a)
end = time.perf_counter()

print(*a, sep=",")
print("Time Taken : %.8f sec" % (end-start))
